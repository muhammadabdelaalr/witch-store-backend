# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/witch_store?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/witch_store?schema=public

# Server
PORT=3000
NODE_ENV=development

# CORS allowlist (comma-separated). In production this must be set explicitly.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Required secrets (must be at least 32 characters in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
# Ed25519 PKCS8 private key encoded as base64. Must match the public key shipped with the POS app.
LICENSE_PRIVATE_KEY_BASE64=replace-with-ed25519-pkcs8-private-key-base64

# Swagger is disabled automatically in production. Enable only in trusted non-production environments.
ENABLE_SWAGGER=true
