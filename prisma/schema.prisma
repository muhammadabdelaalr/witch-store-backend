generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// SAAS / MULTI-TENANCY CONTROL LAYER MODELS
// ==========================================

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  legal_name  String?
  phone       String?
  email       String?
  address     String?
  status      String   @default("active") // active | suspended | expired
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  app_name    String?

  branches               Branch[]
  licenses               License[]
  devices                DeviceActivation[]
  subscriptions          Subscription[]
  payments               Payment[]
  categories             Category[]
  products               Product[]
  customers              Customer[]
  suppliers              Supplier[]
  sales                  Sale[]
  expenses               Expense[]
  customer_transactions  CustomerTransaction[]
  supplier_transactions  SupplierTransaction[]
  supplier_invoices      SupplierInvoice[]
  users                  User[]
  refunds                Refund[]
  supplier_invoice_history SupplierInvoiceHistory[]
  product_stocks         ProductStock[]
  sale_payments          SalePayment[]
  inventory_movements    InventoryMovement[]

  @@map("companies")
}

model Branch {
  id          Int      @id @default(autoincrement())
  company_id  Int
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name        String
  address     String?
  phone       String?
  is_main     Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products            Product[]
  sales               Sale[]
  refunds             Refund[]
  expenses            Expense[]
  supplier_invoices   SupplierInvoice[]
  users               User[]
  product_stocks      ProductStock[]
  inventory_movements InventoryMovement[]

  @@map("branches")
}

model Module {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  plan_modules    PlanModule[]
  license_modules LicenseModule[]

  @@map("modules")
}

model Feature {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  plan_features    PlanFeature[]
  license_features LicenseFeature[]

  @@map("features")
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  price_monthly Float
  price_yearly  Float
  is_lifetime   Boolean  @default(false)
  max_users     Int      @default(5)
  max_devices   Int      @default(5)
  max_branches  Int      @default(1)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  plan_modules  PlanModule[]
  plan_features PlanFeature[]
  licenses      License[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanModule {
  id         Int      @id @default(autoincrement())
  plan_id    Int
  plan       Plan     @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  module_id  Int
  module     Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([plan_id, module_id])
  @@map("plan_modules")
}

model PlanFeature {
  id         Int      @id @default(autoincrement())
  plan_id    Int
  plan       Plan     @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  feature_id Int
  feature    Feature  @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([plan_id, feature_id])
  @@map("plan_features")
}

model License {
  id                Int      @id @default(autoincrement())
  company_id        Int
  company           Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan_id           Int
  plan              Plan     @relation(fields: [plan_id], references: [id])
  license_key       String   @unique
  type              String   @default("subscription") // trial | subscription | lifetime
  status            String   @default("active") // active | expired | suspended | cancelled
  starts_at         DateTime @default(now())
  expires_at        DateTime?
  max_devices       Int      @default(5)
  max_users         Int      @default(5)
  max_branches      Int      @default(1)
  allow_all_modules Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  license_modules   LicenseModule[]
  license_features  LicenseFeature[]
  devices           DeviceActivation[]
  subscriptions     Subscription[]

  @@map("licenses")
}

model LicenseModule {
  id         Int      @id @default(autoincrement())
  license_id Int
  license    License  @relation(fields: [license_id], references: [id], onDelete: Cascade)
  module_id  Int
  module     Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)
  is_enabled Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([license_id, module_id])
  @@map("license_modules")
}

model LicenseFeature {
  id          Int      @id @default(autoincrement())
  license_id  Int
  license     License  @relation(fields: [license_id], references: [id], onDelete: Cascade)
  feature_id  Int
  feature     Feature  @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  is_enabled  Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([license_id, feature_id])
  @@map("license_features")
}

model DeviceActivation {
  id           Int      @id @default(autoincrement())
  company_id   Int
  company      Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  license_id   Int
  license      License  @relation(fields: [license_id], references: [id], onDelete: Cascade)
  device_id    String
  device_name  String?
  platform     String?
  app_version  String?
  activated_at DateTime @default(now())
  last_seen_at DateTime @default(now())
  status       String   @default("active") // active | blocked
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([license_id, device_id])
  @@map("device_activations")
}

model Subscription {
  id                   Int       @id @default(autoincrement())
  company_id           Int
  company              Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  license_id           Int
  license              License   @relation(fields: [license_id], references: [id], onDelete: Cascade)
  plan_id              Int
  plan                 Plan      @relation(fields: [plan_id], references: [id])
  status               String    @default("active") // active | past_due | expired | cancelled
  billing_cycle        String    @default("monthly") // monthly | yearly | lifetime
  current_period_start DateTime  @default(now())
  current_period_end   DateTime
  cancelled_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  payments             Payment[]

  @@map("subscriptions")
}

model PaymentProvider {
  id          Int      @id @default(autoincrement())
  key         String   @unique // manual | paymob | fawry | stripe
  name        String
  is_active   Boolean  @default(true)
  config      String?  // encrypted JSON
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  payments    Payment[]

  @@map("payment_providers")
}

model Payment {
  id              Int              @id @default(autoincrement())
  company_id      Int
  company         Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  subscription_id Int?
  subscription    Subscription?    @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  amount          Float
  currency        String           @default("EGP")
  method          String
  status          String           @default("pending") // pending | failed | paid | refunded
  paid_at         DateTime?
  notes           String?
  provider_id     Int?
  provider        PaymentProvider? @relation(fields: [provider_id], references: [id], onDelete: SetNull)
  provider_reference String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@map("payments")
}

model OwnerAdminUser {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password_hash String          // bcrypt hash
  role          String          @default("owner") // owner | support | sales
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  audit_logs    OwnerAuditLog[]

  @@map("owner_admin_users")
}

model OwnerAuditLog {
  id             Int             @id @default(autoincrement())
  owner_user_id  Int?
  owner_user     OwnerAdminUser? @relation(fields: [owner_user_id], references: [id], onDelete: SetNull)
  action         String
  entity_type    String
  entity_id      Int?
  details        String?
  created_at     DateTime        @default(now())

  @@map("owner_audit_logs")
}

model LicenseAuditLog {
  id              Int      @id @default(autoincrement())
  license_id      Int
  owner_user_id   Int?
  action          String
  old_value       String?
  new_value       String?
  details         String?
  created_at      DateTime @default(now())

  @@map("license_audit_logs")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  token       String?  @unique // deprecated, kept temporarily for migration safety
  token_hash  String   @unique // SHA-256 hex of the raw refresh token
  user_name   String
  device_id   String
  revoked     Boolean  @default(false)
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([device_id])
  @@map("refresh_tokens")
}

model Role {
  id          Int      @id @default(autoincrement())
  key         String   @unique // owner | branch_manager | cashier | sales | inventory | purchasing | accountant | viewer
  name        String
  permissions String[] // e.g. ["users:read", "pos:sale"]
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  users       User[]

  @@map("roles")
}

// ==========================================
// BUSINESS MODELS (MULTI-TENANT CAPABLE)
// ==========================================

model Category {
  id         Int       @id @default(autoincrement())
  company_id Int
  company    Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name       String
  created_at DateTime  @default(now())
  products   Product[]
  expenses   Expense[]

  @@unique([company_id, name])
  @@map("categories")
}

model Product {
  id                  Int        @id @default(autoincrement())
  company_id          Int
  company             Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id           Int?
  branch              Branch?    @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  name                String
  sku                 String?
  barcode             String?
  category_id         Int?
  category            Category?  @relation(fields: [category_id], references: [id])
  factory             String?
  description         String?
  cost_price          Float      @default(0)
  sell_price          Float      @default(0)
  stock_qty           Int        @default(0) // Kept for safety during migration
  low_stock_threshold Int?       @default(5)
  is_active           Boolean    @default(true)
  image_path          String?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  sale_items          SaleItem[]
  refund_items        RefundItem[]
  supplier_invoice_items SupplierInvoiceItem[]
  product_stocks      ProductStock[]
  inventory_movements InventoryMovement[]

  @@unique([company_id, sku])
  @@unique([company_id, barcode])
  @@index([barcode], map: "idx_products_barcode")
  @@index([sku], map: "idx_products_sku")
  @@index([category_id], map: "idx_products_category")
  @@index([company_id, category_id, is_active], map: "idx_products_company_category_active")
  @@map("products")
}

model ProductStock {
  id                  Int      @id @default(autoincrement())
  company_id          Int
  branch_id           Int
  product_id          Int
  stock_qty           Int      @default(0)
  low_stock_threshold Int      @default(5)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  company             Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch              Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([company_id, branch_id, product_id])
  @@index([company_id])
  @@index([branch_id])
  @@index([product_id])
  @@map("product_stocks")
}

model Customer {
  id           Int                   @id @default(autoincrement())
  company_id   Int
  company      Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  address      String?
  balance      Float                 @default(0)
  created_at   DateTime              @default(now())
  sales        Sale[]
  transactions CustomerTransaction[]

  @@unique([company_id, phone])
  @@map("customers")
}

model Supplier {
  id           Int                   @id @default(autoincrement())
  company_id   Int
  company      Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  address      String?
  balance      Float                 @default(0)
  created_at   DateTime              @default(now())
  transactions SupplierTransaction[]
  invoices     SupplierInvoice[]

  @@unique([company_id, phone])
  @@map("suppliers")
}

enum PaymentMethod {
  cash
  instapay
  wallet
  card
  deferred
  installment
}

enum SaleType {
  retail
  wholesale
}

model Sale {
  id              Int            @id @default(autoincrement())
  company_id      Int
  company         Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id       Int?
  branch          Branch?        @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  customer_id     Int?
  customer        Customer?      @relation(fields: [customer_id], references: [id])
  customer_name   String?
  invoice_number  String?
  status          String         @default("completed") // completed | held | cancelled | refunded
  total           Float
  discount        Float          @default(0)
  tax             Float          @default(0)
  amount_paid     Float
  payment_method  PaymentMethod
  sale_type       SaleType       @default(retail)
  notes           String?
  seller_name     String?
  cancel_reason   String?
  cancelled_at    DateTime?
  cancelled_by    String?
  idempotency_key String?        @unique
  created_at      DateTime       @default(now())
  items           SaleItem[]
  refunds         Refund[]
  sale_payments   SalePayment[]

  @@unique([company_id, invoice_number])
  @@index([created_at], map: "idx_sales_date")
  @@index([customer_id], map: "idx_sales_customer")
  @@index([company_id, branch_id, created_at], map: "idx_sales_company_branch_date")
  @@index([company_id, invoice_number], map: "idx_sales_company_invoice")
  @@index([company_id, branch_id, status, created_at], map: "idx_sales_company_branch_status_date")
  @@map("sales")
}

model SaleItem {
  id         Int     @id @default(autoincrement())
  sale_id    Int
  sale       Sale    @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product_id Int
  product    Product @relation(fields: [product_id], references: [id])
  qty        Int
  unit_price Float
  cost_price Float
  line_discount Float @default(0)

  @@index([sale_id], map: "idx_sale_items_sale")
  @@index([product_id], map: "idx_sale_items_product")
  @@map("sale_items")
}

model SalePayment {
  id         Int           @id @default(autoincrement())
  sale_id    Int
  sale       Sale          @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  company_id Int
  company    Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Float
  created_at DateTime      @default(now())

  @@index([sale_id], map: "idx_sale_payments_sale")
  @@index([company_id, method, created_at], map: "idx_sale_payments_company_method_date")
  @@map("sale_payments")
}

model InventoryMovement {
  id              Int      @id @default(autoincrement())
  company_id      Int
  company         Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id       Int
  branch          Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product_id      Int
  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  movement_type   String   // SALE, SALE_CANCEL, PURCHASE, PURCHASE_RETURN, ADJUSTMENT_IN, ADJUSTMENT_OUT, DAMAGE, OPENING, REFUND
  quantity_delta  Int
  balance_after   Int?
  reference_type  String   // sale, refund, purchase, adjustment, etc.
  reference_id    Int
  user_id         Int?
  notes           String?
  created_at      DateTime @default(now())

  @@index([company_id, branch_id, product_id], map: "idx_inventory_movements_company_branch_product")
  @@index([company_id, branch_id, created_at], map: "idx_inventory_movements_company_branch_date")
  @@index([reference_type, reference_id], map: "idx_inventory_movements_reference")
  @@map("inventory_movements")
}

model Expense {
  id          Int       @id @default(autoincrement())
  company_id  Int
  company     Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id   Int?
  branch      Branch?   @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  category_id Int?
  categoryRel Category? @relation(fields: [category_id], references: [id])
  category    String
  amount      Float
  description String?
  date        String    // YYYY-MM-DD
  created_at  DateTime  @default(now())

  @@index([date], map: "idx_expenses_date")
  @@index([category], map: "idx_expenses_category")
  @@map("expenses")
}

enum CustomerTransactionType {
  payment
  debt
}

model CustomerTransaction {
  id          Int                     @id @default(autoincrement())
  company_id  Int
  company     Company                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id Int
  customer    Customer                @relation(fields: [customer_id], references: [id])
  type        CustomerTransactionType
  amount      Float
  notes       String?
  created_at  DateTime                @default(now())

  @@index([customer_id], map: "idx_customer_transactions_customer")
  @@map("customer_transactions")
}

enum SupplierTransactionType {
  payment
  purchase
}

model SupplierTransaction {
  id          Int                     @id @default(autoincrement())
  company_id  Int
  company     Company                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  supplier_id Int
  supplier    Supplier                @relation(fields: [supplier_id], references: [id])
  type        SupplierTransactionType
  amount      Float
  notes       String?
  invoice_id  Int?
  invoice     SupplierInvoice?        @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  seller_name String?
  created_at  DateTime                @default(now())

  @@index([supplier_id], map: "idx_supplier_transactions_supplier")
  @@index([invoice_id], map: "idx_supplier_transactions_invoice")
  @@map("supplier_transactions")
}

model User {
  id               Int      @id @default(autoincrement())
  company_id       Int
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id        Int?
  branch           Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  role_id          Int?
  role             Role?    @relation(fields: [role_id], references: [id], onDelete: SetNull)
  name             String
  email            String?
  password         String   @default("admin") // bcrypt hash
  phone            String
  isAdmin          Boolean  @default(false)
  logs             String   @default("[]") // JSON string storing activity logs
  registrationDate DateTime @default(now())

  @@unique([company_id, name])
  @@index([role_id])
  @@map("users")
}

model Refund {
  id          Int          @id @default(autoincrement())
  company_id  Int
  company     Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id   Int?         @default(1)
  branch      Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  sale_id     Int
  sale        Sale         @relation(fields: [sale_id], references: [id])
  total       Float
  reason      String?
  seller_name String?
  created_at  DateTime     @default(now())
  items       RefundItem[]

  @@index([sale_id], map: "idx_refunds_sale")
  @@map("refunds")
}

model RefundItem {
  id         Int     @id @default(autoincrement())
  refund_id  Int
  refund     Refund  @relation(fields: [refund_id], references: [id], onDelete: Cascade)
  product_id Int
  product    Product @relation(fields: [product_id], references: [id])
  qty        Int
  unit_price Float
  cost_price Float

  @@index([refund_id], map: "idx_refund_items_refund")
  @@map("refund_items")
}

model SupplierInvoice {
  id           Int                      @id @default(autoincrement())
  company_id   Int
  company      Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch_id    Int?
  branch       Branch?                  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  supplier_id  Int
  supplier     Supplier                 @relation(fields: [supplier_id], references: [id])
  total        Float
  amount_paid  Float
  notes        String
  seller_name  String
  invoice_date DateTime
  created_at   DateTime                 @default(now())
  items        SupplierInvoiceItem[]
  transactions SupplierTransaction[]
  history      SupplierInvoiceHistory[]

  @@index([supplier_id], map: "idx_supplier_invoices_supplier")
  @@index([invoice_date], map: "idx_supplier_invoices_date")
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id          Int             @id @default(autoincrement())
  invoice_id  Int
  invoice     SupplierInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product_id  Int
  product     Product         @relation(fields: [product_id], references: [id])
  qty         Int
  unit_cost   Float

  @@index([invoice_id], map: "idx_supplier_invoice_items_invoice")
  @@index([product_id], map: "idx_supplier_invoice_items_product")
  @@map("supplier_invoice_items")
}

model SupplierInvoiceHistory {
  id          Int             @id @default(autoincrement())
  company_id  Int
  company     Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoice_id  Int
  invoice     SupplierInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  seller_name String
  action      String
  changes     String
  created_at  DateTime        @default(now())

  @@map("supplier_invoice_history")
}
